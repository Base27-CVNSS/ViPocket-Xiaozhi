# ViPocket 2.2 uses one local process and one local port.
HOST=127.0.0.1
PORT=5173

# Official/self-hosted Xiaozhi OTA/activation endpoint.
# Leave blank to run the local website without upstream activation.
XIAOZHI_OTA_URL=

# Optional fixed upstream WebSocket mode.
XIAOZHI_WS_URL=
XIAOZHI_ACCESS_TOKEN=

# Local session safety.
ACTIVATION_POLL_MS=2500
SESSION_TTL_MS=1800000
TICKET_TTL_MS=60000
MAX_BODY_BYTES=65536

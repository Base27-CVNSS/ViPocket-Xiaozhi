# ViPocket website + gateway. Keep loopback values for Windows Portable.
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Browser origins allowed during portable and Vite development modes.
PUBLIC_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:5173,http://localhost:5173

# Official or self-hosted Xiaozhi OTA/activation endpoint.
# The gateway sends Activation-Version, Device-Id and Client-Id headers.
XIAOZHI_OTA_URL=

# Optional fixed upstream WebSocket and token when OTA does not return them.
XIAOZHI_WS_URL=
XIAOZHI_ACCESS_TOKEN=

ACTIVATION_POLL_MS=2500
SESSION_TTL_MS=1800000
TICKET_TTL_MS=60000
MAX_BODY_BYTES=65536

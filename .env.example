# ViPocket local website. Keep loopback values for the Windows portable package.
WEB_HOST=127.0.0.1
WEB_PORT=5173

# Gateway listener.
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the gateway.
PUBLIC_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787

# Official/self-hosted Xiaozhi OTA/activation endpoint.
# The gateway calls this endpoint with Activation-Version, Device-Id and Client-Id headers.
XIAOZHI_OTA_URL=

# Optional fixed upstream WebSocket and token for deployments that do not return
# websocket configuration from the OTA endpoint.
XIAOZHI_WS_URL=
XIAOZHI_ACCESS_TOKEN=

# Polling / session safety.
ACTIVATION_POLL_MS=2500
SESSION_TTL_MS=1800000
TICKET_TTL_MS=60000
MAX_BODY_BYTES=65536

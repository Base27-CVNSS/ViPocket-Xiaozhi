{
  "name": "vipocket-xiaozhi",
  "version": "2.0.0",
  "private": true,
  "description": "A bilingual browser voice client and secure gateway compatible with the Xiaozhi WebSocket protocol.",
  "workspaces": [
    "apps/web",
    "apps/gateway"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --workspace @vipocket/web run dev",
    "dev:gateway": "npm --workspace @vipocket/gateway run dev",
    "build": "npm --workspace @vipocket/web run build",
    "start": "npm --workspace @vipocket/gateway run start",
    "test": "npm --workspace @vipocket/gateway run test",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.11"
  }
}

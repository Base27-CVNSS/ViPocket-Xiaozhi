# ViPocket website + gateway. Keep loopback values for Windows Portable.
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Connection mode:
#   auto     = use fixed/custom settings when supplied, otherwise official cloud
#   official = always use the official OTA endpoint from xiaozhi-esp32
#   custom   = require a custom OTA URL or fixed WebSocket credentials
#   offline  = start the local UI without any Xiaozhi upstream
XIAOZHI_MODE=auto

# Browser origins allowed during portable and Vite development modes.
PUBLIC_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:5173,http://localhost:5173

# Optional custom OTA endpoint. Leave blank in auto/official mode.
# Official default: https://api.tenclass.net/xiaozhi/ota/
XIAOZHI_OTA_URL=
XIAOZHI_OTA_TIMEOUT_MS=15000

# Optional fixed upstream WebSocket and token. When both are set in auto mode,
# ViPocket uses them instead of the OTA activation flow.
XIAOZHI_WS_URL=
XIAOZHI_ACCESS_TOKEN=

ACTIVATION_POLL_MS=2500
SESSION_TTL_MS=1800000
TICKET_TTL_MS=60000
MAX_BODY_BYTES=65536
